{
  "info": {
    "_postman_id": "lab7-api-gateway-collection",
    "name": "Lab 7 - API Gateway & Microservices (Local & Cloud)",
    "description": "Postman Collection for testing all Lab 7 microservice routes through the central API Gateway. Supports both Local (http://localhost:3000) and Cloud/Render deployments via the {{gatewayUrl}} collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:3000",
      "type": "string",
      "description": "Base URL of the API Gateway. Change to your Render cloud URL (e.g., https://api-gateway-xyz.onrender.com) for cloud testing."
    }
  ],
  "item": [
    {
      "name": "1. Gateway Health Check (GET /health)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gatewayUrl}}/health",
          "host": ["{{gatewayUrl}}"],
          "path": ["health"]
        },
        "description": "Verifies that the API Gateway is running and reporting healthy status."
      }
    },
    {
      "name": "2. User Service - Create Initial User (POST /users)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"_id\": 101,\n  \"name\": \"Alice Smith\",\n  \"email\": \"alice@campus.edu\",\n  \"role\": \"student\",\n  \"department\": \"Computer Science\"\n}"
        },
        "url": {
          "raw": "{{gatewayUrl}}/users",
          "host": ["{{gatewayUrl}}"],
          "path": ["users"]
        },
        "description": "Routes POST /users through Gateway to User Service. Creates user 101 in database."
      }
    },
    {
      "name": "3. User Service - Get All Users (GET /users)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gatewayUrl}}/users",
          "host": ["{{gatewayUrl}}"],
          "path": ["users"]
        },
        "description": "Routes GET /users through Gateway to User Service. Returns list of users."
      }
    },
    {
      "name": "4. User Service - Get User by ID (GET /users/:id)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gatewayUrl}}/users/101",
          "host": ["{{gatewayUrl}}"],
          "path": ["users", "101"]
        },
        "description": "Routes GET /users/101 through Gateway to User Service."
      }
    },
    {
      "name": "5. User Service - Update User (PUT /users/:id)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alice Smith Updated\",\n  \"email\": \"alice@campus.edu\",\n  \"role\": \"senior_student\",\n  \"department\": \"Software Engineering\"\n}"
        },
        "url": {
          "raw": "{{gatewayUrl}}/users/101",
          "host": ["{{gatewayUrl}}"],
          "path": ["users", "101"]
        },
        "description": "Routes PUT /users/101 through Gateway to User Service."
      }
    },
    {
      "name": "6. User Service - Delete User (DELETE /users/:id)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{gatewayUrl}}/users/101",
          "host": ["{{gatewayUrl}}"],
          "path": ["users", "101"]
        },
        "description": "Routes DELETE /users/101 through Gateway to User Service."
      }
    },
    {
      "name": "7. Product Service - Create Initial Product (POST /products)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"_id\": 501,\n  \"name\": \"Campus Hoodie\",\n  \"price\": 45.00,\n  \"category\": \"Apparel\",\n  \"stock\": 150\n}"
        },
        "url": {
          "raw": "{{gatewayUrl}}/products",
          "host": ["{{gatewayUrl}}"],
          "path": ["products"]
        },
        "description": "Routes POST /products through Gateway to Product Service. Creates product 501 in database."
      }
    },
    {
      "name": "8. Product Service - Get All Products (GET /products)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gatewayUrl}}/products",
          "host": ["{{gatewayUrl}}"],
          "path": ["products"]
        },
        "description": "Routes GET /products through Gateway to Product Service."
      }
    },
    {
      "name": "9. Product Service - Get Product by ID (GET /products/:id)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gatewayUrl}}/products/501",
          "host": ["{{gatewayUrl}}"],
          "path": ["products", "501"]
        },
        "description": "Routes GET /products/501 through Gateway to Product Service."
      }
    },
    {
      "name": "10. Product Service - Update Product (PUT /products/:id)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Campus Hoodie Deluxe\",\n  \"price\": 50.00,\n  \"category\": \"Apparel\",\n  \"stock\": 200\n}"
        },
        "url": {
          "raw": "{{gatewayUrl}}/products/501",
          "host": ["{{gatewayUrl}}"],
          "path": ["products", "501"]
        },
        "description": "Routes PUT /products/501 through Gateway to Product Service."
      }
    },
    {
      "name": "11. Product Service - Delete Product (DELETE /products/:id)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{gatewayUrl}}/products/501",
          "host": ["{{gatewayUrl}}"],
          "path": ["products", "501"]
        },
        "description": "Routes DELETE /products/501 through Gateway to Product Service."
      }
    },
    {
      "name": "12. Order Service - Create Order (POST /orders)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 101,\n  \"productId\": 501,\n  \"quantity\": 2\n}"
        },
        "url": {
          "raw": "{{gatewayUrl}}/orders",
          "host": ["{{gatewayUrl}}"],
          "path": ["orders"]
        },
        "description": "Routes POST /orders through Gateway to Order Service. Validates User 101 and Product 501 via User and Product Services."
      }
    },
    {
      "name": "13. Order Service - Get All Orders (GET /orders)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gatewayUrl}}/orders",
          "host": ["{{gatewayUrl}}"],
          "path": ["orders"]
        },
        "description": "Routes GET /orders through Gateway to Order Service."
      }
    },
    {
      "name": "14. Order Service - Get Order by ID (GET /orders/:id)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gatewayUrl}}/orders/1001",
          "host": ["{{gatewayUrl}}"],
          "path": ["orders", "1001"]
        },
        "description": "Routes GET /orders/:id through Gateway to Order Service."
      }
    },
    {
      "name": "15. Gateway Error Handling - Invalid Route (404 Not Found)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gatewayUrl}}/non-existent-route",
          "host": ["{{gatewayUrl}}"],
          "path": ["non-existent-route"]
        },
        "description": "Sends request to an unmapped gateway path. Expects 404 Not Found."
      }
    },
    {
      "name": "16. Gateway Error Handling - Service Unavailable (503 Service Unavailable)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gatewayUrl}}/users",
          "host": ["{{gatewayUrl}}"],
          "path": ["users"]
        },
        "description": "Call when User Service is stopped (`docker stop user-service` or incorrect USER_SERVICE_URL). Expects 503 Service Unavailable."
      }
    }
  ]
}
