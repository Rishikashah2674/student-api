apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: lab8
  labels:
    app.kubernetes.io/part-of: campusconnect-system
type: Opaque
stringData:
  # Replace with your actual MongoDB Atlas connection URIs
  # Format: mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
  MONGODB_URI_USER: "mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/user_db?retryWrites=true&w=majority"
  MONGODB_URI_PRODUCT: "mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/product_db?retryWrites=true&w=majority"
  MONGODB_URI_ORDER: "mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/order_db?retryWrites=true&w=majority"
